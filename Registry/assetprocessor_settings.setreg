{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder ResourceStats/Assets": {
                    "watch": "@GEMROOT:ResourceStats@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder ResourceStats/Registry": {
                    "watch": "@GEMROOT:ResourceStats@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
