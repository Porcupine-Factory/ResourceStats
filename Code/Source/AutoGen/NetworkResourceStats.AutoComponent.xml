<?xml version="1.0"?>

<Component
    Name="NetworkResourceStats"
    Namespace="ResourceStats"
    OverrideComponent="false"
    OverrideController="true"
    OverrideInclude="Multiplayer/NetworkResourceStats.h"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <NetworkProperty Type="bool" Name="EnableNetworkResourceStats"
                     Init="true" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Determines whether NetworkResourceStats is enabled or disabled."/>
    <NetworkProperty Type="AZ::u32" Name="Health"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The amount of health"/>
    <NetworkProperty Type="AZ::u32" Name="MaxHealth"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Maximum health"/>
    <NetworkProperty Type="AZ::u32" Name="Mana"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The amount of mana"/>
    <NetworkProperty Type="AZ::u32" Name="MaxMana"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Maximum mana"/>
    <NetworkProperty Type="AZ::u32" Name="Strength"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The amount of strength"/>
    <NetworkProperty Type="AZ::u32" Name="MaxStrength"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Maximum strength"/>
    <NetworkProperty Type="AZ::u32" Name="Attack"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The amount of Attack"/>
    <NetworkProperty Type="AZ::u32" Name="MaxAttack"
                     Init="100" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Maximum Attack"/>
    <NetworkProperty Type="AZ::u32" Name="Stamina"
                     Init="20000" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The amount of stamina in milliseconds of sprinting time, only used with the First Person Controller"/>
    <NetworkProperty Type="AZ::u32" Name="MaxStamina"
                     Init="20000" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Maximum stamina in milliseconds of sprinting time, only used with the First Person Controller"/>
    <NetworkProperty Type="AZ::u32" Name="StaminaCooldownTime"
                     Init="10000" ReplicateFrom="Authority"
                     ReplicateTo="Client" Container="Object"
                     IsPublic="true" IsRewindable="true"
                     IsPredictable="false" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The time in milliseconds to wait for stamina to regenerate, only used with the First Person Controller"/>

    <RemoteProcedure Name="SendHealthDelta" InvokeFrom="Server" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Health changed RPC">
        <Param Type="AZ::s64" Name="deltaHealth"/>
    </RemoteProcedure>

    <RemoteProcedure Name="SendManaDelta" InvokeFrom="Server" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Mana changed RPC">
        <Param Type="AZ::s64" Name="deltaMana"/>
    </RemoteProcedure>

    <RemoteProcedure Name="SendStrengthDelta" InvokeFrom="Server" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Strength changed RPC">
        <Param Type="AZ::s64" Name="deltaStrength"/>
    </RemoteProcedure>

    <RemoteProcedure Name="SendAttackDelta" InvokeFrom="Server" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Attack changed RPC">
        <Param Type="AZ::s64" Name="deltaAttack"/>
    </RemoteProcedure>

    <RemoteProcedure Name="SendStaminaDelta" InvokeFrom="Server" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Stamina changed RPC, only used with the First Person Controller">
        <Param Type="AZ::s64" Name="deltaStamina"/>
    </RemoteProcedure>

</Component>
